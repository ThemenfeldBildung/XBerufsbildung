               </entry>
               <entry>
                  <emphasis role="codebf">Code.RechtsgrundlageAbschlusszeugnis</emphasis>
               </entry>
               <entry>
                  <emphasis role="bold">1</emphasis>
               </entry>
               <entry>
                  <xref linkend="XBerufsbildung.Baukasten.Codes.Code.RechtsgrundlageAbschlusszeugnis"
