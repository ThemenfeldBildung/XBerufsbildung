                        role="Seitenzahl"/>
               </entry>
            </row>
            <row>
               <entry rowsep="0" colsep="1"/>
               <entry namest="indent1" nameend="page"><para>Angaben zu den Prüfungsteilen und Prüfungsleistungen sowie deren Bewertung.</para></entry>
            </row>
            <row>
               <entry rowsep="0" colsep="1"/>
