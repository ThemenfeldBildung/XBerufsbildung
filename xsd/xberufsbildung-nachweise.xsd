<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xbbd="http://xberufsbildung.de/def/xberufsbildung/0.7/xsd"
           xmlns:bn-g2g="http://xoev.de/schemata/basisnachricht/g2g/1_1"
           xmlns:din91379="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xbd="http://xbildung.de/def/xbildung/1.2/xsd"
           xmlns:xoev-code="http://xoev.de/schemata/code/1_0"
           targetNamespace="http://xberufsbildung.de/def/xberufsbildung/0.7/xsd"
           version="0.7"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XBerufsbildung</nameLang>
            <nameKurz>XBerufsbildung</nameKurz>
            <nameTechnisch>xberufsbildung</nameTechnisch>
            <kennung>urn:xoev-de:kosit:standard:xberufsbildung</kennung>
            <beschreibung>XBerufsbildung ist ein föderaler IT-Standard, der für die Erstellung von elektronischen Bildungsnachweisen sowie den Datenaustausch im Berufsbildungswesen entwickelt wird. Er ist Teil der Standard-Familie XBildung. </beschreibung>
         </standard>
         <versionStandard>
            <version>0.7</version>
            <beschreibung>Diese Version 0.7 des Standards XBerufsbildung beinhaltet die Aufnahme des Dokuments antragstellende.anerkennungsbescheid sowie Weiterentwicklungen am Datenmodell, fachliche Präzisierungen und redaktionelle Anpassungen.</beschreibung>
            <versionXOEVProfil>3.0.3</versionXOEVProfil>
            <versionXOEVHandbuch>3.0.2</versionXOEVHandbuch>
            <versionXGenerator>3.2.4</versionXGenerator>
            <versionModellierungswerkzeug>19.0 SP 4</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:include schemaLocation="xberufsbildung-baukasten.xsd"/>
   <xs:import schemaLocation="http://www.w3.org/TR/2002/REC-xmldsig-core-20020212/xmldsig-core-schema.xsd"
              namespace="http://www.w3.org/2000/09/xmldsig#"/>
   <xs:import schemaLocation="http://xbildung.de/def/xbildung/1.2/xsd/xbildung-baukasten.xsd"
              namespace="http://xbildung.de/def/xbildung/1.2/xsd"/>
   <xs:import schemaLocation="http://xoev.de/schemata/basisnachricht/g2g/1_1/xoev-basisnachricht-g2g_1.1.xsd"
              namespace="http://xoev.de/schemata/basisnachricht/g2g/1_1"/>
   <xs:import schemaLocation="http://xoev.de/schemata/code/1_0/xoev-code.xsd"
              namespace="http://xoev.de/schemata/code/1_0"/>
   <xs:import schemaLocation="https://xoev.de/schemata/din/91379/2022-08/din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:element name="antragstellende.anerkennungsbescheid">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>&lt;html&gt;
  &lt;head&gt;
		&lt;style&gt;
			p {padding:0px; margin:0px;}
		&lt;/style&gt;
	&lt;/head&gt;
  &lt;body&gt;
BBiG, HwO, Pr&amp;uuml;fungsordnungen der zust&amp;auml;ndigen Stellen&lt;/body&gt;
&lt;/html&gt;</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument bildet den Bescheid über die Feststellung der Gleichwertigkeit der im Ausland erworbenen Berufsqualifikationen ab, z. B. nach BQFG, HwO.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="antragsnummer" type="xs:string">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält eine spezifische Nummer zur eindeutigen Identifikation des zum Bescheid gehörenden Antrags.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zustaendigeStelle" type="xbbd:StelleZustaendig">
                     <xs:annotation>
                        <xs:documentation>Das Element beschreibt die zuständige Stelle, die den Antrag bearbeitet und den Bescheid über die Feststellung der Gleichwertigkeit erstellt hat.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="antragstellendePerson" type="xbbd:AntragstellendePerson">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur Person, die einen Antrag auf einen Bescheid über die Feststellung der Gleichwertigkeit stellt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="referenzberuf">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zum deutschen Referenzberuf, der für die Feststellung der Gleichwertigkeit herangezogen wird.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="referenzausbildungsberuf" type="xbbd:Ausbildungsberuf">
                              <xs:annotation>
                                 <xs:documentation>Angaben zum Ausbildungsberuf, der als Referenz für die Feststellung der Gleichwertigkeit dient, einschließlich Bezeichnung, Fundstelle und optionaler Binnendifferenzierung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="referenzfortbildungsabschluss" type="xbbd:Fortbildungsabschluss">
                              <xs:annotation>
                                 <xs:documentation>Angaben zum Fortbildungsabschluss, der als Referenz für die Feststellung der Gleichwertigkeit dient, einschließlich Bezeichnung, Fundstelle und optionalem Schwerpunkt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="berufsqualifikation">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur Berufsqualifikation.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="ausbildung"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="xbbd:Ausbildung">
                              <xs:annotation>
                                 <xs:documentation>Angaben zur absolvierten Ausbildung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="einschlaegigeBerufserfahrung"
                                       minOccurs="0"
                                       type="xbbd:EinschlaegigeBerufserfahrung">
                              <xs:annotation>
                                 <xs:documentation>Angaben zu einschlägiger Berufserfahrung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="befaehigungsnachweis"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="din91379:datatypeE">
                              <xs:annotation>
                                 <xs:documentation>Bezeichnung oder Art eines vorgelegten Befähigungsnachweises, der zur Beurteilung der fachlichen Qualifikation herangezogen wird (z. B. Weiterbildung, Arbeitsprobe, Fachgespräch oder sonstige Qualifikationsnachweise).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="rechtlicheWuerdigung" type="xbbd:RechtlicheWuerdigung">
                     <xs:annotation>
                        <xs:documentation>Das Element beschreibt die rechtliche Würdigung der vorgelegten Berufsqualifikationen im Rahmen der Entscheidung über die Gleichwertigkeit.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="rechtsbehelfsbelehrung" type="xbd:String.Localized">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Rechtsbehelfsbelehrung zur getroffenen Entscheidung, die dem Bescheid gemäß § 7 Absatz 3 BQFG beizufügen ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur des Bescheids über die Feststellung der Gleichwertigkeit.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="pruefling.berufsschulnote">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>BBiG, Erlasse der Bundesländer</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument dient der Übermittlung der Berufsschulnote von der Berufsschule an die für die Berufsbildung des Prüflings zuständige Stelle. Sie enthält die relevanten Informationen zum Prüfling, zur besuchten Berufsschule, zur für die Berufsbildung des Prüflings zuständigen Stelle sowie zur erreichten Gesamtnote und der Bezeichnung des Ausbildungsberufs. Die Übermittlung erfolgt im Rahmen der gesetzlichen Vorgaben gemäß § 37 Abs. 3 BBiG sowie den jeweiligen landesrechtlichen Vorgaben.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="nachrichtenkopf"
                              minOccurs="0"
                              type="bn-g2g:Nachrichtenkopf.G2GType">
                     <xs:annotation>
                        <xs:documentation>Nachrichtenkopf für Nachrichten zwischen den Berufsschulen und zuständigen Stellen. Der Nachrichtenkopf umfasst Angaben zur eindeutigen Identifikation des Autors und des Lesers der Nachricht sowie der Nachricht selbst.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="berufsschule" type="xbbd:Berufsschule">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur Berufsschule, an der der Prüfling seine schulische Berufsbildung absolviert hat.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zustaendigeStelle" type="xbbd:StelleZustaendig">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur für die Berufsbildung zuständigen Stelle, z. B. einer Industrie- und Handelskammer oder einer Handwerkskammer.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pruefling" type="xbbd:Pruefling">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält identifizierende Angaben zur natürlichen Person, für die die Berufsschulnote übermittelt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ausbildungsberuf" minOccurs="0" type="din91379:datatypeE">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Bezeichnung des erlernten Ausbildungsberufs.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="benotung" type="xbd:Benotung">
                     <xs:annotation>
                        <xs:documentation>Das Element gibt das Ergebnis der berufsschulischen Leistungsfeststellungen des Prüflings an. Die Berechnung der Note erfolgt gemäß den jeweiligen landesrechtlichen Vorgaben. Der Wert der Berufsschulnote wird üblicherweise als Dezimalzahl mit einer Nachkommastelle angegeben (z. B. 2,3).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur des Dokuments.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="auszubildender.eintragungsbestaetigung">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>BBiG, HwO</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument bildet die Eintragungsbestätigung der zuständigen Stelle nach BBiG und HwO ab. Die Eintragung des Ausbildungsvertrags in das Verzeichnis der Berufsausbildungsverhältnisse wird dem Ausbildungsbetrieb und der auszubildenden Person mit einer schriftlichen Eintragungsbestätigung angezeigt. Diese enthält Angaben zur Ausbildung (personenbezogene Daten zum Auszubildenden, Ausbildungsberuf, Ausbildungszeitraum) und Informationen zum Ausbildungsbetrieb (Name, Anschrift).</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="auszubildendePerson" type="xbbd:AuszubildendePerson">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die personenbezogenen Angaben zur auszubildenden Person.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesetzlicheVertretung"
                              minOccurs="0"
                              maxOccurs="2"
                              type="xbbd:GesetzlicheVertretung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur gesetzlichen Vertretung der auszubildenden Person.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenAusbildung" type="xbbd:AngabenAusbildung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur eingetragenen Berufsausbildung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ausbildungsbetrieb"
                              minOccurs="0"
                              type="xbbd:Ausbildungsbetrieb">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zum Ausbildungsbetrieb.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aussteller" type="xbbd:StelleZustaendig">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zur zuständigen Stelle, die die Eintragungsbestätigung ausstellt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="eintragungsnummer" type="xbbd:Identifikation">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Eintragungsnummer des Berufsausbildungsverhältnisses bei der ausstellenden Stelle.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur der Eintragungsbestätigung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="pruefling.fortbildungszeugnis">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>BBiG, HwO, Prüfungsordnungen der zuständigen Stellen</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument bildet ein Fortbildungszeugnis nach BBiG oder HwO ab. Es enthält die für das Zeugnis erforderlichen Angaben zur geprüften Person, zum Fortbildungsabschluss, zu den Prüfungsteilen und Prüfungsleistungen einschließlich deren Bewertungen, zum Gesamtergebnis, zur zugrunde liegenden Fortbildungsordnung, zum Datum des Bestehens der Prüfung sowie zur ausstellenden zuständigen Stelle.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="pruefling" type="xbbd:Pruefling">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält identifizierende Angaben zur natürlichen Person, die geprüft wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="allgemeineAngaben">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält allgemeine Angaben zur abgeschlossenen Fortbildung, einschließlich der Bezeichnung, einer Übersicht der Prüfungsteile und -leistungen sowie deren Benotung, dem DQR-Niveau, ggf. den Handlungsbereichen und einer Befreiung vom schriftlichen Teil der Ausbilder-Eignungsprüfung.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="fortbildungsabschluss" type="xbbd:Fortbildungsabschluss">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält Angaben zur Bezeichnung des Fortbildungsabschlusses, zur Fundstelle der jeweiligen Fortbildungsordnung und ggf. zum Schwerpunkt der Fortbildung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="pruefungsteil"
                                       maxOccurs="unbounded"
                                       type="xbbd:PruefungsteilFortbildungszeugnis">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält Angaben zu den Prüfungsteilen und Prüfungsleistungen sowie deren Bewertung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="handlungsbereich"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="din91379:datatypeE">
                              <xs:annotation>
                                 <xs:documentation>Das Element beschreibt einen spezifischen Kompetenzbereich, in dem die zu prüfende Person Fachwissen und Fähigkeiten nachweisen muss. Jeder Handlungsbereich umfasst bestimmte Aufgaben oder Themenfelder, die in der Prüfungssituation abgedeckt werden, wie z. B. „Jahresabschlüsse aufbereiten und auswerten“ oder „Betriebliche Sachverhalte steuerlich darstellen“.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="befreiungAEVO"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält Angaben zur Befreiung vom schriftlichen Teil der Prüfung nach der Ausbilder-Eignungsverordnung.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="niveauDQR" minOccurs="0" type="xbd:Code.EQF">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält die Einordnung des erworbenen Abschlusses in den Deutschen Qualifikationsrahmen. Das Kernstück des DQR sind acht Referenzniveaus, die den acht Niveaus des Europäischen Qualifikationsrahmens (EQR) entsprechen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="zusaetzlicheAngaben"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xbbd:Bemerkung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält ergänzende Angaben zu den erbrachten Leistungen, die nicht in anderen Elementen abgebildet werden, z. B. eine Befreiung von vergleichbaren Prüfungsbestandteilen. Eine Befreiung vom schriftlichen Teil der Ausbilder-Eignungsprüfung wird gesondert in der Eigenschaft befreiungAEVO angegeben.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesamtergebnis" type="xbd:Benotung">
                     <xs:annotation>
                        <xs:documentation>Das Element fasst die Berechnung der erreichten Note zusammen. Das Gesamtergebnis ist die zusammenfassende Bewertung der Leistungen eines Prüflings, die aus den Einzelbewertungen der verschiedenen Prüfungsteile errechnet wird und den Erfolg oder Misserfolg der gesamten Prüfung widerspiegelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pruefungsdatum" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält das Datum des Bestehens der Fortbildungsprüfung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aussteller" type="xbbd:NameOrganisation">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Bezeichnung der zuständigen Stelle, die das Fortbildungszeugnis ausstellt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur des Fortbildungszeugnisses.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="pruefling.pruefungszeugnis">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>&lt;html&gt;
  &lt;head&gt;
		&lt;style&gt;
			p {padding:0px; margin:0px;}
		&lt;/style&gt;
	&lt;/head&gt;
  &lt;body&gt;
BBiG, HwO, Pr&amp;uuml;fungsordnungen der zust&amp;auml;ndigen Stellen&lt;/body&gt;
&lt;/html&gt;</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument bildet das Prüfungszeugnis der Abschlussprüfung der dualen Ausbildung nach BBiG und HwO ab. Ein Prüfungszeugnis ist ein offizieller Nachweis, der die erfolgreiche Teilnahme an einer Prüfung oder einer Ausbildung bescheinigt und die erlangten Qualifikationen sowie die erreichten Leistungen des Prüflings dokumentiert. Dieses enthält Angaben zum Prüfling, zum Prüfungsergebnis, zum erworbenen Abschluss, zur Rechtsgrundlage, zur ausstellenden Stelle, zum Datum der Prüfung und ggf. weitere zusätzliche Angaben.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="rechtsgrundlage">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Rechtsgrundlage, auf deren Basis das Prüfungszeugnis ausgestellt wird.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="code" type="xbbd:Code.RechtsgrundlageAbschlusszeugnis">
                              <xs:annotation>
                                 <xs:documentation>Diese Codeliste bildet häufig verwendete Rechtsgrundlagen im Rahmen der Ausstellung eines Abschlusszeugnisses ab.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="nichtGelisteterWert" minOccurs="0" type="xs:string">
                              <xs:annotation>
                                 <xs:documentation>In diesem Feld ist die Rechtsgrundlage als Freitext anzugeben. Es steht nur für den Fall zur Verfügung, wenn kein zutreffender Wert in der Codeliste enthalten ist, d. h., wenn dort der Codelisteneintrag "Wert nicht in Liste" ausgewählt wird.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="pruefling" type="xbbd:Pruefling">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält identifizierende Angaben zur natürlichen Person, die geprüft wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesamtergebnis" type="xbd:Benotung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält das Gesamtergebnis der Prüfung als Bewertung nach dem zugrunde liegenden Noten- oder Punktesystem.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="allgemeineAngaben">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält Angaben zum Ausbildungsberuf, zu den Prüfungsteilen und Prüfungsbereichen einschließlich deren Bewertungen, zum DQR-Niveau sowie gegebenenfalls zur Berufsschulnote.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="ausbildungsberuf" type="xbbd:Ausbildungsberuf">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält Angaben zum Ausbildungsberuf einschließlich seiner Bezeichnung sowie optionaler Differenzierungen und Fundstellen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="pruefungsteil"
                                       maxOccurs="unbounded"
                                       type="xbbd:PruefungsteilPruefungszeugnis">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält Angaben zu einem Prüfungsteil einschließlich der zugehörigen Prüfungsbereiche und deren Bewertungen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="niveauDQR" minOccurs="0" type="xbd:Code.EQF">
                              <xs:annotation>
                                 <xs:documentation>Das Element enthält die Einordnung des erworbenen Abschlusses in den Deutschen Qualifikationsrahmen. Das Kernstück des DQR sind acht Referenzniveaus, die den acht Niveaus des Europäischen Qualifikationsrahmens (EQR) entsprechen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="berufsschulnote" minOccurs="0" type="xbd:Benotung">
                              <xs:annotation>
                                 <xs:documentation>Das Element gibt das Ergebnis der berufsschulischen Leistungsfeststellungen an, sofern dieses auf dem Prüfungszeugnis auszuweisen ist. Der Wert der Berufsschulnote wird üblicherweise als Dezimalzahl mit einer Nachkommastelle angegeben (z. B. 2,3).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="zusaetzlicheAngaben"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xbbd:Bemerkung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält ergänzende Angaben zu den erbrachten Leistungen oder zum Prüfungszeugnis, die nicht in anderen Elementen abgebildet werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pruefungsdatum" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält das Datum des Bestehens der Abschlussprüfung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aussteller" type="xbbd:NameOrganisation">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Bezeichnung der zuständigen Stelle, die das Prüfungszeugnis ausstellt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur des Prüfungszeugnisses.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="pruefling.zeugnisAEVO">
      <xs:annotation>
         <xs:appinfo>
            <rechtsgrundlage>BBiG, AEVO, Prüfungsordnungen der zuständigen Stellen</rechtsgrundlage>
         </xs:appinfo>
         <xs:documentation>Dieses Dokument bildet das Zeugnis nach der Ausbilder-Eignungsverordnung (AEVO) vom 21.01.2009 (BGBl. I 2009 S. 88), aus dem hervorgeht, dass der Ausbilder oder die Ausbilderin die berufs- und arbeitspädagogische Qualifikation für die Ausbildung in anerkannten Ausbildungsberufen nach dem Berufsbildungsgesetz nachgewiesen hat.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xbd:Dokument">
               <xs:sequence>
                  <xs:element name="pruefling" type="xbbd:Pruefling">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält identifizierende Angaben zur natürlichen Person, die geprüft wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pruefungsteil"
                              maxOccurs="unbounded"
                              type="xbbd:PruefungsteilAEVO">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Bezeichnung und Benotung des Prüfungsteils. Die Prüfung besteht aus einem schriftlichen und einem praktischen Prüfungsteil.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zusaetzlicheAngaben" minOccurs="0" type="xbbd:Bemerkung">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält ergänzende Angaben zu den erbrachten Leistungen oder zum Prüfungszeugnis, die nicht in anderen Elementen abgebildet werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="pruefungsdatum" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält das Datum der Feststellung des Gesamtergebnisses der Prüfung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aussteller" type="xbbd:NameOrganisation">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die Bezeichnung der zuständigen Stelle, die den Nachweis ausstellt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="ds:Signature" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Das Element enthält die digitale Signatur des Prüfungszeugnisses nach AEVO.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
</xs:schema>
